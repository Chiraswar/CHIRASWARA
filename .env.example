PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-deploying
# Optional SMTP settings. Use an app password / provider credential, never your normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=
# Optional path to a Sinhala-capable .ttf font for PDF reports
SINHALA_FONT_PATH=
